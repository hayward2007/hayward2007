# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local sqlite db
/prisma/*.db
/prisma/*.db-journal
/data

# Portfolio PDFs/zip are large (one appendix is ~190MB) and would blow past
# GitHub's 100MB per-file limit — deployed by direct rsync to the server
# instead of through git. See project memory / deploy notes.
/public/portfolio/*.pdf
/public/portfolio/*.zip
